{
  "compilerOptions": {
    "target": "ES6",
    "module": "NodeNext",
    "rootDir": ".",
    "outDir": "lib/",
    "esModuleInterop": true,
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    "types": [
      "node"
    ],
    "declaration": true
  },
  "include": [
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}
